/* ── shimmer 动画基类 ─────────────────────────────────── */
@keyframes shimmer {
  0%   { background-position: -600rpx 0; }
  100% { background-position:  600rpx 0; }
}

.ske {
  background: linear-gradient(
    90deg,
    #f0f0f0 25%,
    #e4e4e4 37%,
    #f0f0f0 63%
  );
  background-size: 1200rpx 100%;
  animation: shimmer 1.3s infinite linear;
  border-radius: 8rpx;
}

/* ── 通用容器 ────────────────────────────────────────── */
.ske-wrap {
  padding: 16rpx 24rpx;
}

/* ── home：点位卡片 ──────────────────────────────────── */
.ske-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f4f4f4;
}
.ske-card-body { flex: 1; }
.ske-title  { height: 32rpx; width: 60%; margin-bottom: 12rpx; }
.ske-sub    { height: 24rpx; width: 80%; }
.ske-badge  { width: 80rpx; height: 44rpx; border-radius: 22rpx; flex-shrink: 0; margin-left: 16rpx; }

/* ── stats-list：统计行 ──────────────────────────────── */
.ske-stats {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.ske-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.ske-stat-num   { width: 80rpx; height: 44rpx; border-radius: 8rpx; }
.ske-stat-label { width: 60rpx; height: 24rpx; border-radius: 6rpx; }

/* ── 通用列表行 ──────────────────────────────────────── */
.ske-list-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
  gap: 20rpx;
}
.ske-dot         { width: 56rpx; height: 56rpx; border-radius: 8rpx; flex-shrink: 0; }
.ske-icon-circle { width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0; }
.ske-list-body   { flex: 1; }
.ske-row-title   { height: 30rpx; width: 70%; margin-bottom: 10rpx; }
.ske-row-sub     { height: 22rpx; width: 45%; }
.ske-score  { width: 56rpx; height: 30rpx; flex-shrink: 0; }
.ske-amount { width: 72rpx; height: 30rpx; flex-shrink: 0; }

/* ── gift：礼品卡片 ──────────────────────────────────── */
.ske-gift-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.ske-gift-card {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.ske-gift-img  { width: 100%; height: 200rpx; border-radius: 0; }
.ske-gift-info { padding: 16rpx; }
.ske-gift-name { height: 30rpx; width: 80%; margin-bottom: 10rpx; }
.ske-gift-desc { height: 22rpx; width: 60%; margin-bottom: 20rpx; }
.ske-gift-btn  { height: 56rpx; width: 100%; border-radius: 28rpx; }
