.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 顶部积分头 */
.score-header {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  padding: 60rpx 40rpx 50rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 30rpx;
}
.score-label { font-size: 28rpx; opacity: 0.9; margin-bottom: 10rpx; }
.score-val { font-size: 80rpx; font-weight: bold; text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.15); }
.score-hint { font-size: 22rpx; opacity: 0.75; margin-top: 16rpx; text-align: center; line-height: 1.6; }

/* 加载/空状态 */
.loading-tip { text-align: center; color: #999; padding: 60rpx; font-size: 28rpx; }

.empty-box { display:flex; flex-direction:column; align-items:center; padding: 60rpx 40rpx; }
.empty-img { width: 200rpx; height: 200rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; color: #666; font-weight: 500; margin-bottom: 12rpx; }
.empty-sub { font-size: 26rpx; color: #bbb; }

/* 礼品卡片 */
.gift-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 30rpx 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  display: flex;
  flex-direction: row;
  align-items: stretch;
}

.gift-img-wrap {
  position: relative;
  width: 180rpx;
  flex-shrink: 0;
}
.gift-img {
  width: 180rpx;
  height: 100%;
  min-height: 160rpx;
}
.gift-img-placeholder {
  width: 180rpx;
  min-height: 160rpx;
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  display: flex;
  align-items: center;
  justify-content: center;
}
.gift-ph-text { font-size: 56rpx; color: #3b82f6; }

.stock-badge {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: rgba(0,0,0,0.45);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 6rpx 0;
}
.stock-badge.out { background: rgba(239,68,68,0.8); }

/* 礼品信息区 */
.gift-body {
  flex: 1;
  padding: 24rpx 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.gift-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a2332;
  margin-bottom: 8rpx;
}
.gift-desc {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 16rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.gift-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.gift-points { display: flex; align-items: baseline; }
.points-num { font-size: 36rpx; font-weight: bold; color: #f59e0b; }
.points-unit { font-size: 22rpx; color: #9ca3af; }

.exchange-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  margin: 0;
  border: none;
}
.exchange-btn::after { display: none; }
.exchange-btn.disabled {
  background: #f1f5f9;
  color: #94a3b8;
}
