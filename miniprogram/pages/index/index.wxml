<view class="container">
  <!-- 顶部区域 -->
  <view class="home-header">
    <view class="home-search" bindtap="goToSearch">
      <icon type="search" size="14" color="#999"/>
      <text>搜索教育点位</text>
    </view>
  </view>

  <!-- Banner -->
  <view class="home-banner">
    <image class="banner-image" src="/images/home_banner_ai.jpg" mode="aspectFill"></image>
  </view>

  <!-- 实名认证状态横幅
       verifyStatus: 0未提交 1审核中 2已通过(不展示) 3已拒绝 -->

  <!-- 0：未提交 -->
  <view class="auth-reminder" wx:if="{{isLogin && verifyStatus === 0}}" bindtap="goToAuth">
    <view class="auth-reminder-left">
      <view class="auth-reminder-title">尚未实名认证</view>
      <view class="auth-reminder-desc">打卡、积分兑换前需完成本人实名认证</view>
    </view>
    <view class="auth-reminder-action">去认证</view>
  </view>

  <!-- 1：审核中（不可点，不引导用户重复提交） -->
  <view class="auth-reminder pending" wx:elif="{{isLogin && verifyStatus === 1}}">
    <view class="auth-reminder-left">
      <view class="auth-reminder-title">实名认证审核中</view>
      <view class="auth-reminder-desc">通常 1 个工作日内完成审核，请耐心等待</view>
    </view>
    <view class="auth-reminder-action pending">审核中</view>
  </view>

  <!-- 3：已拒绝 -->
  <view class="auth-reminder rejected" wx:elif="{{isLogin && verifyStatus === 3}}" bindtap="goToAuth">
    <view class="auth-reminder-left">
      <view class="auth-reminder-title">实名认证未通过</view>
      <view class="auth-reminder-desc">请重新提交认证资料</view>
    </view>
    <view class="auth-reminder-action rejected">重新认证</view>
  </view>

  <!-- 功能入口 -->
  <view class="home-grid">
    <view class="grid-item" bindtap="goToCheckin">
      <view class="grid-icon-box scan-icon">
        <image class="grid-icon-img" src="/images/scan_color.png" mode="aspectFit"></image>
      </view>
      <text>扫码打卡</text>
    </view>
    <view class="grid-item" bindtap="goToMap">
      <view class="grid-icon-box map-icon">
        <image class="grid-icon-img" src="/images/map_color.png" mode="aspectFit"></image>
      </view>
      <text>教育点导航</text>
    </view>
    <view class="grid-item" bindtap="goToRecord">
      <view class="grid-icon-box record-icon">
        <image class="grid-icon-img" src="/images/record_color.png" mode="aspectFit"></image>
      </view>
      <text>我的记录</text>
    </view>
    <view class="grid-item" bindtap="goToGift">
      <view class="grid-icon-box gift-icon">
        <image class="grid-icon-img" src="/images/gift_color.png" mode="aspectFit"></image>
      </view>
      <text>积分兑换</text>
    </view>
  </view>

  <!-- 公告 -->
  <view class="home-notice" bindtap="goToNotice">
    <view class="notice-tag">公告</view>
    <text class="notice-text">{{notice}}</text>
  </view>

  <!-- 附近教育点 -->
  <view class="home-section">
    <view class="section-header">
      <text class="section-title">附近教育点</text>
      <text class="section-more" bindtap="goToMap">查看全部 ></text>
    </view>

    <!-- 骨架屏 -->
    <skeleton show="{{loading}}" type="home"></skeleton>

    <!-- 有数据 -->
    <block wx:if="{{!loading && nearbyLocations.length > 0}}">
      <view class="point-card" wx:for="{{nearbyLocations}}" wx:key="id"
            bindtap="goToLocationDetail" data-id="{{item.id}}">
        <view class="point-info">
          <view class="point-name">{{item.name}}</view>
          <view class="point-addr">{{item.address || '暂无地址信息'}}</view>
        </view>
        <view class="point-status {{item.isOpen ? 'open' : 'closed'}}">
          {{item.isOpen ? '开放中' : '休息中'}}
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view class="empty-box" wx:if="{{!loading && nearbyLocations.length === 0}}">
      <image class="empty-img" src="/images/empty_location.svg" mode="aspectFit"/>
      <view class="empty-text">暂无附近教育点</view>
      <view class="empty-sub">可前往地图页查看全部点位</view>
    </view>
  </view>
</view>
