.map-page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.map-search {
  background-color: #fff;
  padding: 20rpx 30rpx;
  z-index: 10;
}

.search-inner {
  background-color: #f1f5f9;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #999;
}

.search-inner icon {
  margin-right: 10rpx;
}

.map-area {
  flex: 1;
  width: 100%;
}

.map-component {
  width: 100%;
  height: 100%;
}

.map-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(160deg, #eff6ff 0%, #dbeafe 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.map-ph-icon {
  width: 120rpx;
  height: 120rpx;
  background: rgba(59, 130, 246, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.map-placeholder-text {
  color: #60a5fa;
  font-size: 28rpx;
}

.map-card-list {
  height: 45vh; /* 底部列表占45% */
  background-color: #f5f7fa;
  padding: 20rpx;
  box-sizing: border-box;
}

.map-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.03);
}

.map-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.map-card-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.map-card-dist {
  font-size: 26rpx;
  color: #3b82f6;
  font-weight: bold;
}

.map-card-addr {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.map-card-footer {
  display: flex;
  align-items: center;
}

.map-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
}

.map-tag.open {
  background-color: #dcfce7;
  color: #16a34a;
}

.map-tag.closed {
  background-color: #f3f4f6;
  color: #9ca3af;
}

.map-card-time {
  font-size: 24rpx;
  color: #999;
  flex: 1;
}

.nav-btn {
  margin: 0;
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #3b82f6;
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
}

/* ── 底部空状态 ───────────────────────────────────────── */
.map-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 20rpx;
}
.map-empty-img {
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 20rpx;
}
.map-empty-text {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
  margin-bottom: 10rpx;
}
.map-empty-sub {
  font-size: 24rpx;
  color: #c8c9cc;
}
