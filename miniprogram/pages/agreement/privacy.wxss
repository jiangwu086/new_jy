.page {
  min-height: 100vh;
  padding: 40rpx 34rpx 70rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #172033;
}

.date {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8b93a3;
}

.section {
  margin-top: 36rpx;
}

.section-title {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #263246;
}

.paragraph {
  font-size: 28rpx;
  line-height: 1.72;
  color: #4b5565;
}
