.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 20rpx;
}

.article-list {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
}

.article-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.article-item:last-child {
  border-bottom: none;
}

.article-content {
  flex: 1;
  padding-right: 30rpx;
}

.article-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-date {
  font-size: 24rpx;
  color: #999;
}

.article-arrow {
  color: #ccc;
  font-size: 28rpx;
  font-family: monospace;
}

/* ── 空状态 ─────────────────────────────────────────── */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 100rpx;
}
.empty-img {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 28rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 500;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #c8c9cc;
  text-align: center;
}
