.camera-container {
  width: 100vw;
  height: 100vh;
  background-color: #000;
  display: flex;
  flex-direction: column;
}

.photo-hint {
  height: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: rgba(0,0,0,0.8);
}

.photo-hint text {
  color: #fff;
  font-size: 28rpx;
  background-color: rgba(59,130,246,0.3);
  padding: 8rpx 30rpx;
  border-radius: 30rpx;
}

.camera-view {
  flex: 1;
  width: 100%;
  position: relative;
}

/* 虚线辅助框 */
.camera-silhouette {
  position: absolute;
  top: 10%;
  left: 15%;
  width: 70%;
  height: 60%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.outline-box {
  width: 100%;
  height: 100%;
  border: 4rpx dashed rgba(255,255,255,0.5);
  border-radius: 20rpx;
}

/* 水印区域 */
.watermark {
  position: absolute;
  bottom: 30rpx;
  left: 30rpx;
  display: flex;
  flex-direction: column;
}

.watermark-text {
  color: #fff;
  font-size: 24rpx;
  text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
  margin-top: 8rpx;
}

.photo-controls {
  height: 250rpx;
  background-color: #000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.shutter-btn {
  /* 关键：覆盖小程序 button 的默认 min-width / padding，否则会被撑成椭圆 */
  width: 140rpx !important;
  height: 140rpx !important;
  min-width: 0 !important;
  max-width: none !important;
  padding: 0 !important;
  margin: 0;
  line-height: 140rpx;
  border-radius: 50%;
  background-color: #fff;
  border: 10rpx solid rgba(255,255,255,0.3);
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}
.shutter-btn::after { border: none; }

.shutter-inner {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background-color: #fff;
  border: 4rpx solid #333;
}

.shutter-btn:active .shutter-inner {
  background-color: #e5e7eb;
}
