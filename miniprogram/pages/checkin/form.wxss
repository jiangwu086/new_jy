.container {
  min-height: 100vh;
  background-color: #f5f7fa;
}

.checkin-header {
  background: linear-gradient(180deg, #3b82f6 0%, #60a5fa 100%);
  padding: 60rpx 40rpx 100rpx;
  color: #fff;
}

.checkin-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.checkin-hint {
  font-size: 26rpx;
  opacity: 0.9;
}

.checkin-form {
  background-color: #ffffff;
  border-radius: 24rpx;
  margin: -60rpx 30rpx 0;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
  z-index: 2;
}

.form-section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
  text-align: center;
  border-bottom: 2rpx dashed #eee;
  padding-bottom: 20rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-input {
  background-color: #f8fafc;
  height: 88rpx;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid #e2e8f0;
}

.form-input[disabled] {
  color: #999;
  background-color: #f1f5f9;
}

.phone-input-wrap {
  display: flex;
  align-items: center;
}

.phone-input-wrap .form-input {
  flex: 1;
}

.get-phone-btn {
  margin-left: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  background-color: #e0e7ff;
  color: #4f46e5;
  border-radius: 12rpx;
  border: none;
}
.get-phone-btn::after {
  border: none;
}

.checkin-submit-btn {
  display: block;
  width: 100%;
  margin: 60rpx auto 0;
  padding: 0;
  background-color: #3b82f6;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  box-shadow: 0 8rpx 16rpx rgba(59, 130, 246, 0.3);
}

.checkin-submit-btn::after { border: none; }

.checkin-submit-btn:active {
  opacity: 0.9;
}

.checkin-form-tips {
  margin-top: 60rpx;
  padding: 0 40rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tip-item icon {
  margin-right: 12rpx;
}

.tip-item text {
  font-size: 24rpx;
  color: #8892a4;
}

.checkin-loading { padding: 80rpx 40rpx; text-align: center; }
.loading-text { color: #999; font-size: 28rpx; }
.checkin-progress { margin: 24rpx 0 32rpx; }
.progress-bar-bg {
  height: 12rpx; background: #e5e7eb; border-radius: 6rpx; overflow: hidden; margin-bottom: 12rpx;
}
.progress-bar-fill {
  height: 100%; background: #3b82f6; border-radius: 6rpx; transition: width 0.3s;
}
.progress-label { font-size: 24rpx; color: #6b7280; }
.form-value {
  padding: 22rpx 24rpx; background: #f3f4f6; border-radius: 12rpx;
  font-size: 30rpx; color: #374151; letter-spacing: 2rpx;
}
.checkin-submit-btn.disabled { background: #9ca3af !important; }
