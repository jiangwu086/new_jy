<view class="container success-page">
  <!-- 成功动画区 -->
  <view class="success-icon-wrap">
    <view class="success-circle">
      <icon type="success" size="60" color="#ffffff"/>
    </view>
  </view>

  <view class="success-title">打卡成功！</view>
  <view class="success-points">+{{pointsEarned}} 积分</view>

  <!-- 详细信息卡片 -->
  <view class="success-card">
    <view class="info-row">
      <text class="info-key">打卡地点</text>
      <text class="info-val">{{locationName}}</text>
    </view>
    <view class="info-row">
      <text class="info-key">打卡时间</text>
      <text class="info-val">{{checkinTime}}</text>
    </view>
    <view class="info-row">
      <text class="info-key">本周期进度</text>
      <text class="info-val">{{currentCount}} / {{maxCount}} 次</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-row">
    <button class="action-btn outline" bindtap="goToRecord">查看记录</button>
    <button class="action-btn primary" bindtap="goHome">返回首页</button>
  </view>
</view>
