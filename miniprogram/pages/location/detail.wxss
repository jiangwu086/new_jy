.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 120rpx;
}

.loc-banner {
  width: 100%;
  height: 400rpx;
  background-color: #e2e8f0;
  display: flex;
  justify-content: center;
}

.loc-header {
  background-color: #fff;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.loc-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.loc-tags {
  display: flex;
}

.tag {
  font-size: 22rpx;
  color: #666;
  background-color: #f1f5f9;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.tag.open {
  background-color: #dcfce7;
  color: #16a34a;
}

.loc-section {
  background-color: #fff;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  border-left: 8rpx solid #3b82f6;
  padding-left: 20rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.info-icon {
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.info-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
  box-sizing: border-box;
}

.nav-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #3b82f6;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
}

.loc-banner {
  height: 160rpx;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  display: flex;
  align-items: center;
  justify-content: center;
}
.status-badge {
  padding: 8rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #fff;
  background: rgba(255,255,255,0.25);
}
.status-badge.open { background: rgba(16,185,129,0.7); }
.status-badge.closed { background: rgba(239,68,68,0.7); }
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0; right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  gap: 20rpx;
}
.nav-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 0;
  margin: 0;
  text-align: center;
}
.nav-btn::after { border: none; }
.nav-btn.outline { background: #fff; color: #3b82f6; border: 2rpx solid #3b82f6; }
.nav-btn.primary { background: #3b82f6; color: #fff; border: none; }
.loading-box { display: flex; align-items: center; justify-content: center; height: 400rpx; }
.loading-text { color: #999; font-size: 28rpx; }
