.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 120rpx;
}

.loc-header {
  background-color: #fff;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.loc-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.loc-tags {
  display: flex;
}

.tag {
  font-size: 22rpx;
  color: #666;
  background-color: #f1f5f9;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.tag.open {
  background-color: #dcfce7;
  color: #16a34a;
}

.loc-section {
  background-color: #fff;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  border-left: 8rpx solid #3b82f6;
  padding-left: 20rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.info-icon {
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.info-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 底部按钮组：透明悬浮，不再带白色面板和阴影 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0; right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: transparent;
  display: flex;
  gap: 20rpx;
  pointer-events: none;     /* 容器不拦截滑动，只让按钮自身可点 */
}
.bottom-bar .nav-btn {
  pointer-events: auto;
}
.nav-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 0;
  margin: 0;
  text-align: center;
}
.nav-btn::after { border: none; }
.nav-btn.outline { background: #fff; color: #3b82f6; border: 2rpx solid #3b82f6; }
.nav-btn.primary { background: #3b82f6; color: #fff; border: none; }
.loading-box { display: flex; align-items: center; justify-content: center; height: 400rpx; }
.loading-text { color: #999; font-size: 28rpx; }
